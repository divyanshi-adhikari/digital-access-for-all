{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/admin-login", "destination": "/admin-lock.html" },
    { "source": "/admin-dashboard", "destination": "/admin.html" },
    { "source": "/community", "destination": "/community.html" }, 
    { "source": "/gov/:path*", "destination": "/server.js" },
    { "source": "/sync/:path*", "destination": "/server.js" },
    { "source": "/health", "destination": "/server.js" },
    { "source": "/community/:path*", "destination": "/server.js" }
  ]
}



