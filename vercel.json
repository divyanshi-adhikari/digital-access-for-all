{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/home.html" },
    { "src": "/admin", "dest": "/admin-lock.html" },
    { "src": "/admin/:path*", "dest": "/admin-lock.html" },
    { "src": "/gov/(.*)", "dest": "/server.js" },
    { "src": "/sync/(.*)", "dest": "/server.js" },
    { "src": "/health", "dest": "/server.js" },
    { "src": "/community.*", "dest": "/server.js" },
    { "src": "/(.*\\.(html|css|js|png|jpg|ico))", "dest": "/$1" }
  ]
}